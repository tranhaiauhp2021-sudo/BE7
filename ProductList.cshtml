@model PagedList.IPagedList<MyStore.Models.Product>
@using PagedList.Mvc
@{
    ViewBag.Title = ViewBag.CategoryName;
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}
<section class="product-section">
    <div class="section-heading"><div><p class="eyebrow">CATEGORY</p><h1>@ViewBag.CategoryName</h1></div></div>
    @if (Model.Count == 0)
    {
        <p class="empty-message">Chưa có sản phẩm trong danh mục này.</p>
    }
    else
    {
        <div class="product-grid">
            @foreach (var product in Model)
            {
                @Html.Partial("~/Views/Shared/_ProductCard.cshtml", product)
            }
        </div>
        <div class="pagination">@Html.PagedListPager(Model, page => Url.Action("ProductList", "Home", new { id = ViewBag.CategoryID, page }))</div>
    }
</section>
