@model MyStore.Models.ViewModel.LoginVM
@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}
@section styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/myStyle/CustomerAccount.css")" />
}

<section class="account-page">
    <div class="account-card">
        <p class="eyebrow">WELCOME BACK</p>
        <h1>Đăng nhập</h1>
        <p class="account-intro">Đăng nhập để tiếp tục trải nghiệm mua sắm tại MyStore.</p>
        @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "account-form", autocomplete = "on" }))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("returnUrl", (string)ViewBag.ReturnUrl)
            @Html.ValidationSummary(true, "", new { @class = "validation-summary" })
            <div class="account-field">
                @Html.LabelFor(m => m.Username)
                @Html.TextBoxFor(m => m.Username, new { @class = "account-input", autocomplete = "username", required = "required" })
                @Html.ValidationMessageFor(m => m.Username, "", new { @class = "field-error" })
            </div>
            <div class="account-field">
                @Html.LabelFor(m => m.Password)
                @Html.PasswordFor(m => m.Password, new { @class = "account-input", autocomplete = "current-password", required = "required" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-error" })
            </div>
            <button type="submit" class="primary-button account-submit">Đăng nhập</button>
        }
        <p class="account-switch">Chưa có tài khoản? <a href="@Url.Action("Register", "Account")">Đăng ký ngay</a></p>
    </div>
</section>
